# Copy this file to .env and set the key/model for your own OpenAI API account.
# Do not commit backend/.env or place this secret in a VITE_* variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_BASE_URL=https://api.openai.com/v1
ANUGYA_SATYAPAK_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
